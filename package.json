{
  "name": "burger-truck-attendance",
  "version": "1.0.0",
  "description": "Offline-first attendance for a food truck: employees clock in with their own phone by scanning a paper QR poster",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "dev": "wrangler d1 migrations apply burger-truck-attendance --local && wrangler dev",
    "deploy:setup": "node scripts/deploy-cloudflare.mjs --setup",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "backup": "wrangler d1 export burger-truck-attendance --remote --output backup.sql"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "qrcode-generator": "^2.0.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
